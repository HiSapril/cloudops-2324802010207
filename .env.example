# Cấu hình bảo mật Django
SECRET_KEY=your-super-secret-django-key-change-this-in-production
DEBUG=False
ALLOWED_HOSTS=192.168.100.10,localhost,127.0.0.1

# Cấu hình cơ sở dữ liệu MySQL
# (Nếu không khai báo DB_NAME, hệ thống sẽ tự động fallback sang SQLite3 để kiểm thử local)
DB_NAME=cloud_asset_db
DB_USER=app_user
DB_PASSWORD=your_secure_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306
